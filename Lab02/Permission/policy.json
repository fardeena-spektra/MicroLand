{
  "Version": "2012-10-17",
  "Statement": [

    {
      "Sid": "AllowS3FullAccess",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "*"
    },

    {
      "Sid": "AllowCloudFormation",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": "*"
    },

    {
      "Sid": "AllowEC2",
      "Effect": "Allow",
      "Action": "ec2:*",
      "Resource": "*"
    },

    {
      "Sid": "AllowIAMReadAndCreateForLabOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoles",
        "iam:ListPolicies",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies"
      ],
      "Resource": "*"
    },

    {
      "Sid": "AllowPassRoleForLabServicesOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::*:role/cft-vpc-role",
        "arn:aws:iam::*:role/Lab-S3-ReadOnly-Role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "cloudformation.amazonaws.com",
            "ec2.amazonaws.com"
          ]
        }
      }
    },

    {
      "Sid": "DenyIAMDeletionFullStop",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRole",
        "iam:DeleteUser",
        "iam:DeletePolicy",
        "iam:DetachRolePolicy",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": "*"
    },

    {
      "Sid": "DenyCreatingSensitiveIAMEntities",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreatePolicy"
      ],
      "Resource": "*"
    }

  ]
}