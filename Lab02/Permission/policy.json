{
  "Version": "2012-10-17",
  "Statement": [

    {
      "Sid": "AllowS3FullAccessInUsEast1",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },

    {
      "Sid": "AllowCloudFormationInUsEast1",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },

    {
      "Sid": "AllowEC2InUsEast1",
      "Effect": "Allow",
      "Action": "ec2:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },

    {
      "Sid": "AllowIAMReadAndCreateRolesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListRoles",
        "iam:CreateRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:ListAttachedRolePolicies",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies"
      ],
      "Resource": "*"
    },

    {
      "Sid": "AllowPassRoleForCloudFormationAndEC2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::*:role/cft-vpc-role",
        "arn:aws:iam::*:role/Lab-S3-ReadOnly-Role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "cloudformation.amazonaws.com",
            "ec2.amazonaws.com"
          ]
        }
      }
    },

    {
      "Sid": "DenyIAMDeleteAndUserGroupManagement",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRole",
        "iam:DeletePolicy",
        "iam:DetachRolePolicy",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:CreateUser",
        "iam:CreateGroup",
        "iam:AddUserToGroup",
        "iam:RemoveUserFromGroup",
        "iam:DeleteUser",
        "iam:DeleteGroup"
      ],
      "Resource": "*"
    }

  ]
}